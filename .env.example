# Скопируй в .env и заполни. Файл .env в репозиторий не коммитится.

# PostgreSQL (docker-compose)
POSTGRES_USER=fa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fa
DATABASE_URL=postgres://fa:change-me@localhost:5432/fa

# Backend
PORT=3000

# Basic auth для «Обмена с сайтом» (1С). Боевые значения — только через менеджер секретов.
EXCHANGE_LOGIN=
EXCHANGE_PASSWORD=
