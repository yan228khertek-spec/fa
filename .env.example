# Скопируй в .env и заполни. Файл .env в репозиторий не коммитится.

# PostgreSQL (docker-compose)
POSTGRES_USER=fa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fa
DATABASE_URL=postgres://fa:change-me@localhost:5432/fa

# Backend
PORT=3000

# Basic auth для «Обмена с сайтом» (1С). Сгенерировать:
#   openssl rand -base64 18
# Боевые значения — только в .env на сервере, не в репозиторий и не в чаты.
EXCHANGE_LOGIN=
EXCHANGE_PASSWORD=

# Максимальный размер одного POST-куска от 1С (ответ init: file_limit), байт.
EXCHANGE_FILE_LIMIT=10485760

# Куда складывать принятые файлы обмена (по умолчанию ./spool).
# ВНИМАНИЕ: каталог чистится при каждом mode=init — фото там не живут.
EXCHANGE_SPOOL_DIR=spool

# Постоянное хранилище фото из 1С (A2/M1): после успешного import сюда
# переносится spool/unpacked/import_files, отсюда Caddy отдаёт /images/*.
# Пусто — перенос выключен.
EXCHANGE_MEDIA_DIR=media

# Сколько ждать разбора import.xml, прежде чем ответить 1С `progress`, мс.
# Короткие выгрузки успевают за один запрос, длинные грузятся в фоне,
# и 1С повторяет mode=import до ответа success.
EXCHANGE_IMPORT_WAIT_MS=5000

# Предел суммарного распакованного размера одного zip, байт (защита от
# zip-бомбы: file_limit ограничивает только один POST, но не распаковку).
EXCHANGE_UNPACK_LIMIT=2147483648

# Админка брендов (/admin). Пустые значения — админка выключена.
# Логин/пароль задать на сервере; боевые значения не коммитить и не пересылать.
ADMIN_LOGIN=
ADMIN_PASSWORD=
# Куда складываются загруженные фото и логотипы брендов.
ADMIN_UPLOADS_DIR=uploads
# Публичный адрес бэкенда: API отдаёт абсолютные ссылки на фото (пусто — относительные).
PUBLIC_BASE_URL=
# Откуда сайт берёт фото товаров из 1С (по умолчанию PUBLIC_BASE_URL + /images/).
IMAGES_BASE_URL=
# Тип цены 1С для витрины (имя из ТипыЦен). Пусто — минимум по всем типам. Решение 13.10.
SITE_PRICE_TYPE=Розничные
# Склад 1С для остатка витрины (имя из Склады). Пусто — сумма по всем складам (двоит). Решение 13.10.
SITE_STOCK_WAREHOUSE=Касса ТЗ 2 Fashion Avenue

# Заказы (трек F1). ⚠️ Тариф СДЭК, порог бесплатной доставки, адрес самовывоза и версии
# документов с заказчиком НЕ согласованы — меняются здесь, без правки кода и контракта.
# Выключатель приёма заказов: 0 — POST /api/orders отвечает 503.
ORDERS_ENABLED=1
# Фикс-тариф СДЭК v1, ₽ (заглушка, не согласован).
ORDER_CDEK_FEE=500
# Бесплатная доставка СДЭК от суммы товаров, ₽ (взято с бегущей строки макета, не подтверждено).
# Пусто — порога нет.
ORDER_FREE_DELIVERY_FROM=20000
# Адрес магазина для самовывоза (показывается в чекауте); пусто — не показывается.
ORDER_PICKUP_ADDRESS=
# Версии оферты, политики ПД и текста согласия на рассылку — фиксируются в заказе/согласии.
ORDER_OFFER_VERSION=draft-2026-10
ORDER_PD_POLICY_VERSION=draft-2026-10
ORDER_MARKETING_CONSENT_VERSION=draft-2026-10
# Не больше ORDER_RATE_LIMIT попыток оформления с одного IP за ORDER_RATE_WINDOW_MS.
ORDER_RATE_LIMIT=20
ORDER_RATE_WINDOW_MS=600000
