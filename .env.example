# Скопируй в .env и заполни. Файл .env в репозиторий не коммитится.

# PostgreSQL (docker-compose)
POSTGRES_USER=fa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fa
DATABASE_URL=postgres://fa:change-me@localhost:5432/fa

# Backend
PORT=3000

# Basic auth для «Обмена с сайтом» (1С). Сгенерировать:
#   openssl rand -base64 18
# Боевые значения — только в .env на сервере, не в репозиторий и не в чаты.
EXCHANGE_LOGIN=
EXCHANGE_PASSWORD=

# Максимальный размер одного POST-куска от 1С (ответ init: file_limit), байт.
EXCHANGE_FILE_LIMIT=10485760

# Куда складывать принятые файлы обмена (по умолчанию ./spool).
EXCHANGE_SPOOL_DIR=spool
