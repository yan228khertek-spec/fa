# Шаблон .env для сервера (docker-compose.prod.yml).
# На сервере: cp .env.production.example .env && nano .env
# Значения генерировать НА СЕРВЕРЕ, в репозиторий и чаты не копировать:
#   openssl rand -hex 16        # пароль Postgres
#   openssl rand -base64 18     # пароль обмена для 1С

# Домен приёмника (A-запись должна указывать на этот сервер) и email
# для уведомлений Let's Encrypt.
EXCHANGE_DOMAIN=1c-dev.avenuefashion.online
ACME_EMAIL=

# PostgreSQL (внутри compose, наружу не публикуется)
POSTGRES_USER=fa
POSTGRES_PASSWORD=
POSTGRES_DB=fa

# Basic auth «Обмена с сайтом» — эти логин/пароль вводятся в настройке 1С
EXCHANGE_LOGIN=fa-1c
EXCHANGE_PASSWORD=

# Максимальный размер одного POST-куска от 1С (ответ init: file_limit), байт.
# Держать <= лимита тела в deploy/Caddyfile (сейчас 100MB).
EXCHANGE_FILE_LIMIT=10485760

# Предел суммарного распакованного размера одного zip (защита от zip-бомбы).
EXCHANGE_UNPACK_LIMIT=2147483648

# Сколько ждать разбора import.xml до ответа 1С `progress`, мс.
EXCHANGE_IMPORT_WAIT_MS=5000

# Постоянное хранилище фото из 1С (A2/M1). В compose уже задано как /app/media
# (том media, Caddy отдаёт его по /images/*) — переопределять обычно не нужно.
# EXCHANGE_MEDIA_DIR=/app/media

# Админка брендов: https://<EXCHANGE_DOMAIN>/admin. Пустые логин/пароль = админка выключена.
#   openssl rand -base64 18      # пароль админки (не тот же, что у обмена)
ADMIN_LOGIN=fa-admin
ADMIN_PASSWORD=

# Публичный адрес бэкенда — в ссылках API на фото брендов. Должен совпадать с доменом сайта-клиента API.
PUBLIC_BASE_URL=https://1c-dev.avenuefashion.online

# Откуда сайт берёт фото товаров из 1С. Пусто = PUBLIC_BASE_URL + /images/ (работает с A2/M1).
IMAGES_BASE_URL=

# Тип цены 1С, который витрина показывает как цену (имя из ТипыЦен). Решение 13.10 — «Розничные».
# Пусто — минимум по всем типам цен.
SITE_PRICE_TYPE=Розничные
# Склад 1С, по которому считается остаток витрины (имя из Склады). Решение 13.10 — «Касса ТЗ 2 Fashion Avenue».
# Пусто — сумма по всем складам, включая общий остаток (двоит остатки 1С).
SITE_STOCK_WAREHOUSE=Касса ТЗ 2 Fashion Avenue

# Заказы (трек F1). ⚠️ Тариф СДЭК, порог бесплатной доставки, адрес самовывоза и версии
# документов с заказчиком НЕ согласованы — меняются здесь, без правки кода и контракта.
# Выключатель приёма заказов: 0 — POST /api/orders отвечает 503.
ORDERS_ENABLED=1
# Фикс-тариф СДЭК v1, ₽ (заглушка, не согласован).
ORDER_CDEK_FEE=500
# Бесплатная доставка СДЭК от суммы товаров, ₽ (взято с бегущей строки макета, не подтверждено).
# Пусто — порога нет.
ORDER_FREE_DELIVERY_FROM=20000
# Адрес магазина для самовывоза (показывается в чекауте); пусто — не показывается.
ORDER_PICKUP_ADDRESS=
# Версии оферты, политики ПД и текста согласия на рассылку — фиксируются в заказе/согласии.
ORDER_OFFER_VERSION=draft-2026-10
ORDER_PD_POLICY_VERSION=draft-2026-10
ORDER_MARKETING_CONSENT_VERSION=draft-2026-10
# Не больше ORDER_RATE_LIMIT попыток оформления с одного IP за ORDER_RATE_WINDOW_MS.
ORDER_RATE_LIMIT=20
ORDER_RATE_WINDOW_MS=600000

# Выгрузка заказов в 1С (трек F2, sale:query). Продавец (ИП Астафьев) выводится
# контрагентом-продавцом в документ, только если задан; имена реквизитов — дефолты
# CommerceML, уточняются у 1С-специалиста (Часть 4). Пусто — продавец не выводится.
# Реквизиты заказчика (мастер-план 1a): ИНН 550700629713.
SALE_SELLER_NAME=
SALE_SELLER_INN=
SALE_TIME_ZONE=Europe/Moscow
SALE_SCHEMA_VERSION=2.05
SALE_BATCH_LIMIT=500
