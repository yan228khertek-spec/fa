# Шаблон .env для сервера (docker-compose.prod.yml).
# На сервере: cp .env.production.example .env && nano .env
# Значения генерировать НА СЕРВЕРЕ, в репозиторий и чаты не копировать:
#   openssl rand -hex 16        # пароль Postgres
#   openssl rand -base64 18     # пароль обмена для 1С

# Домен приёмника (A-запись должна указывать на этот сервер) и email
# для уведомлений Let's Encrypt.
EXCHANGE_DOMAIN=1c-dev.avenuefashion.online
ACME_EMAIL=

# PostgreSQL (внутри compose, наружу не публикуется)
POSTGRES_USER=fa
POSTGRES_PASSWORD=
POSTGRES_DB=fa

# Basic auth «Обмена с сайтом» — эти логин/пароль вводятся в настройке 1С
EXCHANGE_LOGIN=fa-1c
EXCHANGE_PASSWORD=

# Максимальный размер одного POST-куска от 1С (ответ init: file_limit), байт.
# Держать <= лимита тела в deploy/Caddyfile (сейчас 100MB).
EXCHANGE_FILE_LIMIT=10485760

# Предел суммарного распакованного размера одного zip (защита от zip-бомбы).
EXCHANGE_UNPACK_LIMIT=2147483648

# Сколько ждать разбора import.xml до ответа 1С `progress`, мс.
EXCHANGE_IMPORT_WAIT_MS=5000
