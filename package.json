{
  "name": "fa",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Fashion Avenue — интернет-магазин: приёмник CommerceML (1С:Розница 2.3) + витрина",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint packages && prettier --check \"packages/**/*.{ts,js,json,md}\" \"docs/adr/**/*.md\" \"*.json\" \".github/**/*.yml\"",
    "format": "prettier --write \"packages/**/*.{ts,js,json,md}\" \"docs/adr/**/*.md\" \"*.json\" \".github/**/*.yml\"",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run dev -w @fa/backend"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
